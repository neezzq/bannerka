# Скопируйте этот файл в .env и впишите свои значения:
#   cp .env.example .env && nano .env
# После изменения .env перезапустите: docker compose up -d --force-recreate

# Пароль от админки (лучше длинный, 10+ символов)
ADMIN_PASSWORD=поменяй-меня

# Токен Telegram-бота от @BotFather (можно оставить пустым — уведомлений не будет)
TG_TOKEN=

# Необязательно: chat_id, куда слать заявки (через запятую).
# Проще написать боту: /login ваш_пароль — он сам запомнит чат.
TG_CHAT_ID=

# Адрес сайта — для кнопки «Открыть админку» в уведомлениях
SITE_URL=https://banerka.ru

# Часовой пояс — по нему считаются «сегодня» и срочность
TZ=Europe/Moscow

# ===== ЮKassa (онлайн-оплата полной суммы). Пусто — оплата выключена =====
# Личный кабинет ЮKassa → Интеграция → Ключи API
YK_SHOP_ID=
YK_SECRET_KEY=
# 1 — отправлять чек по 54-ФЗ через ЮKassa (тогда клиент вводит email). 0 — без чеков
YK_RECEIPT=0
# Ставка НДС в чеке: 1 — без НДС (самозанятые, ИП на УСН)
YK_VAT_CODE=1
# Система налогообложения (необязательно): 1 ОСН, 2 УСН доходы, 3 УСН доходы-расходы, 6 патент
YK_TAX_SYSTEM=
